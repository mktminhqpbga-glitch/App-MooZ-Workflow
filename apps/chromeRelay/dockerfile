# syntax=docker/dockerfile:1
FROM oven/bun:1.4.3
WORKDIR /app
COPY . .
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then \
      SSL_CERT_FILE=/run/secrets/proxy_ca bun install --frozen-lockfile --ignore-scripts; \
    else bun install --frozen-lockfile --ignore-scripts; fi
ENV TOONFLOW_RELAY_HOST=0.0.0.0
CMD ["bun", "apps/chromeRelay/src/index.ts"]
